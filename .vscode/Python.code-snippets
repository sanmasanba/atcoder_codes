				"\tinv[1] = 1",
				"\tfor i in range(2, n+10):",
					"\t\tfact[i] = fact[i-1] * i % MOD1e7",
					"\t\tinv[i] = MOD1e7 - inv[MOD1e7%i] * (MOD1e7//i) % MOD1e7",
					"\t\tfact_inv[i] = fact_inv[i-1] * inv[i] % MOD1e7",
			"",
			"def nCk(n, k):",
				"\t\"\"\"",
				"\tnCk mod PをO(1)で返す",
