	"SegmentTree":{
		"prefix": "SegmentTree",
		"body": [
			"class SegmentTree:",
				"\t\"\"\"",
				"\thttps://qiita.com/takayg1/items/b7b3f7d458915bcc7a4e",
				"\t\"\"\"",
				"\tdef __init__(self, iter: Iterator, func: Callable[..., int], ele: Any) -> None:",
					"\t\t\"\"\"",
					"\t\titer: Iterator(初期化対象)",
					"\t\tfunc: 評価関数",
					"\t\tele: 単位元(モノイドの単位元)",
					"\t\t\"\"\"",
					"\t\tN = len(iter)",
					"\t\tself.func = func",
					"\t\tself.ele = ele",
					"\t\tself.length = 1 << (N - 1).bit_length()",
					"\t\tself.tree = [ele] * 2*self.length",
			"",
					"\t\tfor i in range(N):",
						"\t\t\tself.tree[self.length + i] = iter[i]",
					"\t\tfor i in range(self.length-1, 0, -1):",
						"\t\t\tself.tree[i] = self.func(self.tree[2*i], self.tree[2*i + 1])",
			"",
				"\tdef update(self, index: int, value: Any) -> None:",
					"\t\t\"\"\"",
					"\t\tindex: 更新対象",
					"\t\tvalue: 更新値",
					"\t\tindex(0-index)の値をvalueに更新する",
					"\t\t\"\"\"",
					"\t\tindex += self.length",
			"\t\tself.tree[index] = value",
			"\t\twhile index > 1:",
				"\t\t\tindex >>= 1",
				"\t\t\tself.tree[index] = self.func(self.tree[2 * index], self.tree[2 * index + 1])",
			"",
				"\tdef add(self, index: int, value: Any) -> None:",
					"\t\t\"\"\"",
					"\t\tindex: 更新対象",
					"\t\tvalue: 更新値",
					"\t\tindex(0-index)の値にvalueを加算する",
					"\t\t\"\"\"",
					"\t\tindex += self.length",
			"\t\tself.tree[index] += value",
			"\t\twhile index > 1:",
				"\t\t\tindex >>= 1",
				"\t\t\tself.tree[index] = self.func(self.tree[2 * index], self.tree[2 * index + 1])",
			"",
				"\tdef get(self, l, r):",
					"\t\t\"\"\"",
					"\t\t[l, r)の区間の値に関して",
					"\t\tself.funcで評価を行いO(logN)で返す",
					"\t\t\"\"\"",
					"\t\tres = self.ele",
			"",
					"\t\tl += self.length",
					"\t\tr += self.length",
					"\t\twhile l < r:",
						"\t\t\tif l & 1:",
							"\t\t\t\tres = self.func(res, self.tree[l])",
							"\t\t\t\tl += 1",
						"\t\t\tif r & 1:",
							"\t\t\t\tres = self.func(res, self.tree[r - 1])",
						"\t\t\tl >>= 1",
						"\t\t\tr >>= 1",
					"\t\treturn res",
			"",
			"def seg_func(x, y):",
				"\treturn x + y",
				]
	},
	"遅延セグ木（汎用）": {
		"prefix": "lazy_seg_tree",
		"body": [
			"DataT = TypeVar('DataT')",
			"LazyT = TypeVar('LazyT')",
			"",
			"class LazySegmentTree(Generic[DataT, LazyT]):",
				"\t\"\"\"",
				"\t区間作用を差し替えて使う軽量な遅延セグ木。区間は半開区間 [l, r)。",
				"\tref: https://github.com/not522/ac-library-python/blob/master/atcoder/lazysegtree.py",
				"\t\"\"\"",
				"\tdef __init__(",
					"\t\tself,",
					"\t\tvalues: List[DataT],",
					"\t\top: Callable[[DataT, DataT], DataT],",
					"\t\te: DataT,",
					"\t\tmapping: Callable[[LazyT, DataT], DataT],",
					"\t\tcomposition: Callable[[LazyT, LazyT], LazyT],",
					"\t\tid_: LazyT,",
					"\t) -> None:",
					"\t\t\"\"\"",
					"\t\tvalues: 各要素の初期値",
					"\t\top: 左右2つの区間データを結合する関数。結合律を満たす必要がある",
					"\t\te: 空区間の値。opの単位元",
					"\t\tmapping: 作用fを区間データxに適用した結果を返す関数",
					"\t\tcomposition: 作用fをgの後に適用した合成作用を返す関数",
					"\t\tid_: 何もしない作用。lazyの単位元で、eとは異なることがある",
					"\t\tmapping(f, op(x, y)) == op(mapping(f, x), mapping(f, y)) が必要",
					"\t\t\"\"\"",
					"\t\tself.n = len(values)",
					"\t\tself.size = 1 << (self.n - 1).bit_length() if self.n else 1",
					"\t\tself.log = self.size.bit_length() - 1",
					"\t\tself.op = op",
					"\t\tself.e = e",
					"\t\tself.mapping = mapping",
					"\t\tself.composition = composition",
					"\t\tself.id_ = id_",
					"\t\tself.data = [e] * (2 * self.size)",
					"\t\tself.lazy = [id_] * self.size",
					"\t\tself.data[self.size:self.size + self.n] = values",
					"\t\tfor k in range(self.size - 1, 0, -1):",
					"\t\t\tself._update(k)",
			"",
				"\tdef set(self, p: int, x: DataT) -> None:",
					"\t\t\"\"\"p番目をxに更新する。\"\"\"",
					"\t\tself._push_path(p)",
					"\t\tk = self.size + p",
					"\t\tself.data[k] = x",
					"\t\tfor i in range(1, self.log + 1):",
					"\t\t\tself._update(k >> i)",
			"",
				"\tdef get(self, p: int) -> DataT:",
					"\t\t\"\"\"p番目の値を返す。\"\"\"",
					"\t\tself._push_path(p)",
					"\t\treturn self.data[self.size + p]",
			"",
				"\tdef prod(self, l: int, r: int) -> DataT:",
					"\t\t\"\"\"[l, r)の総積を返す。空区間はeを返す。\"\"\"",
					"\t\tif l == r:",
					"\t\t\treturn self.e",
					"\t\tl += self.size",
					"\t\tr += self.size",
					"\t\tl0, r0 = l, r",
					"\t\tfor i in range(self.log, 0, -1):",
					"\t\t\tif ((l >> i) << i) != l:",
					"\t\t\t\tself._push(l >> i)",
					"\t\t\tif ((r >> i) << i) != r:",
					"\t\t\t\tself._push((r - 1) >> i)",
					"\t\tsml, smr = self.e, self.e",
					"\t\twhile l < r:",
						"\t\t\tif l & 1:",
							"\t\t\t\tsml = self.op(sml, self.data[l])",
							"\t\t\t\tl += 1",
						"\t\t\tif r & 1:",
							"\t\t\t\tr -= 1",
							"\t\t\t\tsmr = self.op(self.data[r], smr)",
						"\t\t\tl >>= 1",
						"\t\t\tr >>= 1",
					"\t\tfor i in range(1, self.log + 1):",
						"\t\t\tif ((l0 >> i) << i) != l0:",
							"\t\t\t\tself._update(l0 >> i)",
						"\t\t\tif ((r0 >> i) << i) != r0:",
							"\t\t\t\tself._update((r0 - 1) >> i)",
					"\t\treturn self.op(sml, smr)",
			"",
				"\tdef all_prod(self) -> DataT:",
					"\t\treturn self.data[1]",
			"",
				"\tdef apply_point(self, p: int, f: LazyT) -> None:",
					"\t\t\"\"\"p番目に作用fを適用する。\"\"\"",
					"\t\tself._push_path(p)",
					"\t\tk = self.size + p",
					"\t\tself.data[k] = self.mapping(f, self.data[k])",
					"\t\tfor i in range(1, self.log + 1):",
					"\t\t\tself._update(k >> i)",
			"",
				"\tdef apply(self, l: int, r: int, f: LazyT) -> None:",
					"\t\t\"\"\"[l, r)の全要素に作用fを適用する。\"\"\"",
					"\t\tif l == r:",
					"\t\t\treturn",
					"\t\tl += self.size",
					"\t\tr += self.size",
					"\t\tl0, r0 = l, r",
					"\t\tfor i in range(self.log, 0, -1):",
					"\t\t\tif ((l >> i) << i) != l:",
					"\t\t\t\tself._push(l >> i)",
					"\t\t\tif ((r >> i) << i) != r:",
					"\t\t\t\tself._push((r - 1) >> i)",
					"\t\twhile l < r:",
						"\t\t\tif l & 1:",
							"\t\t\t\tself._all_apply(l, f)",
							"\t\t\t\tl += 1",
						"\t\t\tif r & 1:",
							"\t\t\t\tr -= 1",
							"\t\t\t\tself._all_apply(r, f)",
						"\t\t\tl >>= 1",
						"\t\t\tr >>= 1",
					"\t\tfor i in range(1, self.log + 1):",
						"\t\t\tif ((l0 >> i) << i) != l0:",
							"\t\t\t\tself._update(l0 >> i)",
						"\t\t\tif ((r0 >> i) << i) != r0:",
							"\t\t\t\tself._update((r0 - 1) >> i)",
			"",
				"\tdef _update(self, k: int) -> None:",
					"\t\tself.data[k] = self.op(self.data[2 * k], self.data[2 * k + 1])",
			"",
				"\tdef _all_apply(self, k: int, f: LazyT) -> None:",
					"\t\tself.data[k] = self.mapping(f, self.data[k])",
					"\t\tif k < self.size:",
					"\t\t\tself.lazy[k] = self.composition(f, self.lazy[k])",
			"",
				"\tdef _push(self, k: int) -> None:",
					"\t\tf = self.lazy[k]",
					"\t\tif f == self.id_:",
					"\t\t\treturn",
					"\t\tself._all_apply(2 * k, f)",
					"\t\tself._all_apply(2 * k + 1, f)",
					"\t\tself.lazy[k] = self.id_",
			"",
				"\tdef _push_path(self, p: int) -> None:",
					"\t\tfor i in range(self.log, 0, -1):",
					"\t\t\tself._push((self.size + p) >> i)",
			"",
		]
