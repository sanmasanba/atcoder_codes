				"\t\"\"\"",
				"\tglobal fact, fact_inv, inv",
				"\tassert not (n < k)",
				"\tassert not ((n < 0) or (k < 0))",
				"\treturn fact[n] * (fact_inv[k] * fact_inv[n-k] % MOD1e7) % MOD1e7",
