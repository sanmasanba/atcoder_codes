			"def runlength_encoding(raw: Iterable[T]) -> List[Tuple[T, int]]:",
				"\tl, n = 0, len(raw)",
				"\tres = []",
				"\twhile l < n:",
					"\t\tr = l + 1",
					"\t\twhile r < n and raw[l] == raw[r]:",
						"\t\t\tr += 1",
					"\t\tres.append((raw[l], r - l))",
					"\t\tl = r",
				"\treturn res",
		]
	},
