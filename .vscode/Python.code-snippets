	"強連結成分の列挙": {
		"prefix": "scc",
		"body": [
			"class Scc(NamedTuple):",
				"\tsccs: List[List[int]]",
				"\tcomp_id: List[int]",
				"\tdag: List[List[int]]",
			"",
			"def scc(G: List[List[int]], N: int) -> Scc:",
				"\t\"\"\"",
				"\tKosaraju法で強連結成分分解を行い、縮約DAGも構築する。",
			"",
				"\tArgs:",
					"\t\tG: 有向グラフ（隣接リスト）",
					"\t\tN: 頂点数（0-indexed）",
			"",
				"\tReturns:",
					"\t\tScc:",
						"\t\t\tsccs: 各強連結成分の頂点リスト",
						"\t\t\tcomp_id: 各頂点が属する成分番号",
						"\t\t\tdag: 成分を縮約したDAG（隣接リスト）",
				"\t\"\"\"",
				"\tH = [[] for _ in range(N)]",
				"\tfor u in range(N):",
					"\t\tfor v in G[u]:",
						"\t\t\tH[v].append(u)",
			"",
				"\tScc = namedtuple('Scc', ['sccs', 'comp_id', 'dag'])",
			"",
				"\tused = [False] * N",
				"\tI = []",
			"",
				"\tdef dfs1(v: int):",
					"\t\tused[v] = True",
					"\t\tfor nextv in G[v]:",
						"\t\t\tif not used[nextv]:",
							"\t\t\t\tdfs1(nextv)",
					"\t\tI.append(v)",
			"",
				"\tfor i in range(N):",
					"\t\tif not used[i]:",
						"\t\t\tdfs1(i)",
			"",
				"\tused = [False] * N",
				"\tsccs = []",
				"\tcomp_id = [-1] * N",
			"",
				"\tdef dfs2(v: int, cid: int, connected_nodes: List[int]):",
					"\t\tused[v] = True",
					"\t\tconnected_nodes.append(v)",
					"\t\tcomp_id[v] = cid",
					"\t\tfor nextv in H[v]:",
						"\t\t\tif not used[nextv]:",
							"\t\t\t\tdfs2(nextv, cid, connected_nodes)",
			"",
				"\tI.reverse()",
				"\tfor i in I:",
					"\t\tif used[i]:",
						"\t\t\tcontinue",
					"\t\tconnected_nodes = []",
					"\t\tcid = len(sccs)",
					"\t\tdfs2(i, cid, connected_nodes)",
					"\t\tsccs.append(connected_nodes)",
			"",
				"\tdag_sets = [set() for _ in range(len(sccs))]",
				"\tfor u in range(N):",
					"\t\tfor v in G[u]:",
						"\t\t\tu_id = comp_id[u]",
						"\t\t\tv_id = comp_id[v]",
						"\t\t\tif u_id != v_id:",
							"\t\t\t\tdag_sets[u_id].add(v_id)",
			"",
				"\tdag = [list(s) for s in dag_sets]",
				"\treturn Scc(sccs, comp_id, dag)",
		]
	},

