	"Rolling hash": {
		"prefix": "rolling_hash",
		"body": [
			"class RollingHash:",
				"\t\"\"\"rolling hash",
				"\tAttributes:",
					"\t\t_MOD1 (int): 素数の法1",
					"\t\t_MOD2 (int): 素数の法2",
					"\t\t_BASE (int): hashの基数",
				"\t\"\"\"",
				"\t_MOD1 = MOD1e7",
				"\t_MOD2 = MOD998",
				"\t_BASE = 1007",
				"\tdef __init__(self, s:str):",
					"\t\tself.s = s",
					"\t\tself.n = len(s)",
					"\t\tself._hash1 = [0] * (self.n + 1)",
					"\t\tself._hash2 = [0] * (self.n + 1)",
					"\t\tself._pow1 = [1] * (self.n + 1)",
					"\t\tself._pow2 = [1] * (self.n + 1)",
					"\t\tself.generate_hash()",
				"\t",
				"\tdef generate_hash(self):",
					"\t\t\"\"\"hashの事前計算",
					"\t\t\"\"\"",
					"\t\tfor i in range(self.n):",
						"\t\t\tchar_code = ord(self.s[i])",
						"\t\t\t# calc hash",
						"\t\t\tself._hash1[i+1] = (self._hash1[i] * self._BASE + char_code) % self._MOD1",
						"\t\t\tself._hash2[i+1] = (self._hash2[i] * self._BASE + char_code) % self._MOD2",
						"\t\t\t# calc pow",
						"\t\t\tself._pow1[i+1] = (self._pow1[i] * self._BASE) % self._MOD1",
						"\t\t\tself._pow2[i+1] = (self._pow2[i] * self._BASE) % self._MOD2",
				"\t",
				"\tdef get_hash(self, l:int, r:int) -> Tuple[int, int]:",
					"\t\t\"\"\"[l, r)のhashを獲得",
			"",
					"\t\tArgs:",
						"\t\t\tl (int): 部分文字列の左端",
						"\t\t\tr (int): 部分文字列の右端",
			"",
					"\t\tRaises:",
						"\t\t\tValueError: 範囲が不正",
			"",
					"\t\tReturns:",
						"\t\t\tTuple[int, int]: 二つのハッシュのタプル",
					"\t\t\"\"\"",
					"\t\tif not (0 <= l <= r <= self.n):",
						"\t\t\traise ValueError('Invalid range for get_hash')",
					"\t\t# get hash",
					"\t\th1 = self._hash1[r] - (self._hash1[l] * self._pow1[r-l]) % self._MOD1",
					"\t\tif h1 < 0: h1 += self._MOD1",
					"\t\th2 = self._hash2[r] - (self._hash2[l] * self._pow2[r-l]) % self._MOD2",
					"\t\tif h2 < 0: h2 += self._MOD2",
			"",
					"\t\treturn (h1, h2)",
		]
	},
