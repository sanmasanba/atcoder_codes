				"\tfor p in range(2, isqrt(N)+1):",
					"\t\tif not isprime[p]:",
						"\t\t\tcontinue",
					"",
					"\t\tq = p * p",
					"\t\twhile q <= N:",
						"\t\t\tisprime[q] = False",
