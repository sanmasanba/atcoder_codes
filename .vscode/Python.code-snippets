	"三次元累積和": {
		"prefix": "cumsum3d",
		"body": [
			"class cumsum3d:",
				"\t\"\"\"",
				"\t3次元累積和",
				"\t\"\"\"",
				"\tdef __init__(self, A: List[int]):",
					"\t\tX = len(A)",
					"\t\tY = len(A[0])",
					"\t\tZ = len(A[0][0])",
					"\t\tself.cumsum = [[[0]*(Z+1) for _ in range(Y+1)] for _ in range(X+1)]",
					"\t\tfor x in range(X):",
						"\t\t\tfor y in range(Y):",
							"\t\t\t\tfor z in range(Z):",
								"\t\t\t\t\tself.cumsum[x+1][y+1][z+1] = (",
									"\t\t\t\t\t\tA[x][y][z]",
									"\t\t\t\t\t\t+ self.cumsum[x][y+1][z+1]",
									"\t\t\t\t\t\t+ self.cumsum[x+1][y][z+1]",
									"\t\t\t\t\t\t+ self.cumsum[x+1][y+1][z]",
									"\t\t\t\t\t\t- self.cumsum[x][y][z+1]",
									"\t\t\t\t\t\t- self.cumsum[x][y+1][z]",
									"\t\t\t\t\t\t- self.cumsum[x+1][y][z]",
									"\t\t\t\t\t\t+ self.cumsum[x][y][z]",
								"\t\t\t\t\t)",
				"\t",
				"\tdef get(self, lx: int, rx: int, ly: int, ry: int, lz: int, rz: int) -> int:",
					"\t\t\"\"\"",
					"\t\t(lx, ly, lz)と(rx, ry, rz)で囲まれた空間の累積を求める",
					"\t\t\"\"\"",
					"\t\treturn (",
						"\t\t\tself.cumsum[rx][ry][rz]",
						"\t\t\t- self.cumsum[lx][ry][rz]",
						"\t\t\t- self.cumsum[rx][ly][rz]",
						"\t\t\t- self.cumsum[rx][ry][lz]",
						"\t\t\t+ self.cumsum[lx][ly][rz]",
						"\t\t\t+ self.cumsum[lx][ry][lz]",
						"\t\t\t+ self.cumsum[rx][ly][lz]",
						"\t\t\t- self.cumsum[lx][ly][lz]",
					"\t\t)",
		]
	},

